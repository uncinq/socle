{
  "name": "socle",
  "version": "1.0.0",
  "private": true,
  "description": "Documentation site for a framework-agnostic CSS foundation, four packages covering tokens, reset, layouts and components.",
  "homepage": "https://socle.uncinq.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/uncinq/socle.git"
  },
  "author": {
    "name": "Un Cinq",
    "url": "https://uncinq.dev/"
  },
  "license": "MIT",
  "scripts": {
    "watch": "hugo server",
    "build": "hugo --gc --minify",
    "build:icons": "yarn build:icons:bootstrap",
    "build:icons:bootstrap": "node scripts/build-icons-bootstrap.js",
    "build:search": "yarn build && npm_config_yes=true npx pagefind --site 'public'",
    "install:hugolify": "hugo mod get && hugo mod npm pack",
    "clean": "hugo mod clean",
    "tidy": "hugo mod tidy",
    "update": "hugo mod get -u"
  },
  "dependencies": {
    "@uncinq/component-tokens": "^1.9.3",
    "@uncinq/css-base": "^1.9.0",
    "@uncinq/css-components": "^1.15.3",
    "@uncinq/design-tokens": "^1.7.3"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "autoprefixer": "^10.4.13",
    "bootstrap-icons": "^1.13.1",
    "cssnano": "^5.1.14",
    "js-yaml": "^5.4.2",
    "netlify-plugin-hugo-cache-resources": "^0.2.1",
    "postcss": "^8.4.21",
    "postcss-cli": "^10.1.0",
    "subset-font": "^2.9.0"
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
